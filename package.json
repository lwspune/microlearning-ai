{
  "name": "microlearning-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verify": "python -m unittest discover -s verify -p \"test_*.py\"",
    "content:verify": "node scripts/export-content.ts .content && python verify/verify_content.py .content",
    "smoke": "node scripts/smoke-routes.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/db/types.ts",
    "content:seed": "node scripts/seed-content.ts",
    "e2e": "node e2e/golden-path.ts",
    "e2e:roles": "node e2e/roles.ts",
    "e2e:people": "node e2e/people.ts",
    "user:create": "node scripts/user-create.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "katex": "0.18.9",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "1.63.0",
    "supabase": "2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
